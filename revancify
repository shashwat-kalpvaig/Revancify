#!/usr/bin/bash

REPO="shashwat-kalpvaig/Revancify"
BRANCH="main"
SRC="$HOME/Revancify"

HELP="revancify

Usage: revancify [OPTION]

Options:
-f:  Force re-install Revancify
-u:  Disable Update Check
-r:  Disable Root access
-v:  Print current version
-h:  Print help statement"

while getopts ":furvh" OPT 2> /dev/null; do
    case $OPT in
        f)
            rm "$SRC/.info" &> /dev/null
            ;;
        u)
            INTERNET_ACCESS=false
            ;;
        r)
            ROOT_ACCESS=false
            ;;
        v)
            if [ -e "$SRC/.info" ]; then
                source "$SRC/.info"
                echo "$VERSION"
            else
                echo "Revancify not installed !!"
            fi
            exit
            ;;
        h)
            echo -e "$HELP"
            exit
            ;;
        ?)
            echo -e "Invalid option specified: -${OPTARG}"
            echo -e "$HELP"
            exit 1
            ;;
    esac
done

terminate() {
    killall -9 curl &> /dev/null
    killall -9 wget &> /dev/null
    clear
    echo "Script terminated !!"
    exit 1
}
trap terminate SIGTERM SIGINT SIGABRT

if [ -z "$PREFIX" ] || [[ "$PREFIX" != *com.termux* ]]; then
    echo "Termux not detected !!"
    exit 1
fi

# downloadGitHubAsset REPO JQ_FILTER OUTPUT [EXECUTABLE]
# JQ_FILTER selects one asset of the latest release.
downloadGitHubAsset() {
    local REPOSITORY="$1" FILTER="$2" OUTPUT="$3" CTR RESPONSE
    for CTR in 1 2 3; do
        readarray -t RESPONSE < <(
            curl -sL --max-time 20 "https://api.github.com/repos/$REPOSITORY/releases/latest" |
                jq -r --arg ARCH "$ARCH" "[.assets[] | select($FILTER)][0] // empty | .browser_download_url, .size" 2> /dev/null
        )
        [ "${#RESPONSE[@]}" -eq 2 ] || continue
        wget -q --show-progress "${RESPONSE[0]}" -O "$OUTPUT"
        if [ "${RESPONSE[1]}" == "$(stat -c %s "$OUTPUT" 2> /dev/null)" ]; then
            return 0
        fi
        rm -f "$OUTPUT"
    done
    return 1
}

installDependencies() {
    local PKGS=()
    echo "Checking dependencies..."

    java -version &> /dev/null || PKGS+=("openjdk-21")
    command -v wget &> /dev/null || PKGS+=("wget")
    command -v tput &> /dev/null || PKGS+=("ncurses-utils")
    command -v dialog &> /dev/null || PKGS+=("dialog")
    command -v pup &> /dev/null || PKGS+=("pup")
    command -v jq &> /dev/null || PKGS+=("jq")
    command -v unzip &> /dev/null || PKGS+=("unzip")
    command -v killall &> /dev/null || PKGS+=("psmisc")
    command -v termux-open &> /dev/null || PKGS+=("termux-tools")

    if [ "${#PKGS[@]}" -ne 0 ]; then
        echo -e "\nInstalling: ${PKGS[*]}\n"
        export DEBIAN_FRONTEND=noninteractive
        # A full upgrade first avoids broken partial upgrades (e.g. libssl mismatches).
        yes | pkg update -y
        yes | pkg upgrade -y
        yes | pkg install -y "${PKGS[@]}" || return 1
        java -version &> /dev/null || return 1
    fi

    if [ ! -d "$HOME/storage/shared" ]; then
        echo -e "\nAllow the storage permission when Android asks for it."
        termux-setup-storage
        for _ in $(seq 30); do
            [ -d "$HOME/storage/shared" ] && break
            sleep 1
        done
        if [ ! -d "$HOME/storage/shared" ]; then
            echo "Storage permission not granted. Run 'termux-setup-storage' and try again."
            return 1
        fi
    fi

    # Lets Revancify open the patched APK in the package installer.
    mkdir -p "$HOME/.termux"
    touch "$HOME/.termux/termux.properties"
    if grep -q '^# *allow-external-apps' "$HOME/.termux/termux.properties"; then
        sed -i 's/^# *allow-external-apps.*/allow-external-apps = true/' "$HOME/.termux/termux.properties"
    elif ! grep -q '^allow-external-apps' "$HOME/.termux/termux.properties"; then
        echo "allow-external-apps = true" >> "$HOME/.termux/termux.properties"
    fi
    termux-reload-settings &> /dev/null

    mkdir -p "$SRC/bin"

    ARCH=$(getprop ro.product.cpu.abi)

    if [ ! -s "$SRC/bin/aapt2" ]; then
        echo -e "\nDownloading aapt2...\n"
        downloadGitHubAsset "decipher3114/binaries" '.name | endswith($ARCH)' "$SRC/bin/aapt2" || return 1
        chmod +x "$SRC/bin/aapt2"
    fi

    if [ ! -s "$SRC/bin/APKEditor.jar" ]; then
        echo -e "\nDownloading APKEditor...\n"
        downloadGitHubAsset "REAndroid/APKEditor" '.name | endswith(".jar")' "$SRC/bin/APKEditor.jar" || return 1
    fi

    return 0
}

fetchSrc() {
    local REMOTE_VERSION TMP CONTENT

    [ -e "$SRC/.info" ] && source "$SRC/.info"

    [ "$INTERNET_ACCESS" == false ] && return
    [ "$REVANCIFY_UPDATED" == true ] && return

    echo "Checking for updates..."

    REMOTE_VERSION=$(curl -sL --max-time 10 "https://raw.githubusercontent.com/$REPO/$BRANCH/.info" 2> /dev/null | sed -n "s/^VERSION='\(.*\)'$/\1/p")

    if [ -z "$REMOTE_VERSION" ]; then
        [ -e "$SRC/main.sh" ] && return
        echo -e "Unable to download Revancify !!\nCheck your internet connection and try again."
        exit 1
    fi

    [ "$REMOTE_VERSION" == "$VERSION" ] && [ -e "$SRC/main.sh" ] && return

    echo "Installing Revancify $REMOTE_VERSION..."

    TMP=$(mktemp -d "${TMPDIR:-$PREFIX/tmp}/revancify.XXXXXX")
    if curl -fsSL --max-time 120 "https://github.com/$REPO/archive/refs/heads/$BRANCH.zip" -o "$TMP/src.zip" &&
        unzip -qo "$TMP/src.zip" -d "$TMP"; then
        mkdir -p "$SRC"
        # Replace only files shipped in the repo; keep assets, apps, bin and .config.
        for CONTENT in "$TMP"/Revancify-*/* "$TMP"/Revancify-*/.[!.]*; do
            [ -e "$CONTENT" ] || continue
            rm -rf "${SRC:?}/$(basename "$CONTENT")"
            mv "$CONTENT" "$SRC/"
        done
        rm -rf "$TMP"
        cp -f "$SRC/revancify" "$PREFIX/bin/revancify"
        chmod +x "$PREFIX/bin/revancify"
        echo -e "Revancify $REMOTE_VERSION is now installed.\nRun 'revancify -h' for help."
        sleep 1
        REVANCIFY_UPDATED=true exec "$PREFIX/bin/revancify" "$@"
    else
        rm -rf "$TMP"
        echo -e "Unable to install Revancify $REMOTE_VERSION !!\nPlease try again with proper Internet"
        [ -e "$SRC/main.sh" ] || exit 1
    fi
}

clear

if ! installDependencies; then
    echo -e "Dependencies not installed !!\nRun again with stable internet connection."
    exit 1
fi

fetchSrc "$@"

if [ "$ROOT_ACCESS" != false ] && su -c 'exit' &> /dev/null; then
    ROOT_ACCESS=true
else
    ROOT_ACCESS=false
fi

cd "$SRC" &> /dev/null || terminate

bash main.sh "$ROOT_ACCESS"
EXIT_CODE=$?

exit "$EXIT_CODE"
